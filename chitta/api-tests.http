### ==========================================================================
### MyKanban Backend — HTTP Client Test File
### ==========================================================================
### Compatible with: IntelliJ HTTP Client, VS Code REST Client
###
### Variables are defined below. After login, copy the token into @token.
### ==========================================================================

@host = http://localhost:8080
@contentType = application/json

### ------ Default credentials (change after first use) ------
@email = admin@mykanban.local
@password = admin123

### ------ Paste your JWT token here after login ------
@token = YOUR_JWT_TOKEN_HERE


### ========================================================================
### 1. SYSTEM
### ========================================================================

### Health Check (no auth required)
GET {{host}}/api/health
Accept: {{contentType}}


### ========================================================================
### 2. AUTHENTICATION
### ========================================================================

### Login — returns JWT token
# @name login
POST {{host}}/api/v1/auth/login
Content-Type: {{contentType}}

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Change Password (requires auth)
POST {{host}}/api/v1/auth/change-password
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "old_password": "admin123",
  "new_password": "newSecure123!"
}

### Google OAuth Login (redirects to Google)
GET {{host}}/api/v1/auth/google/login


### ========================================================================
### 3. PROJECTS
### ========================================================================

### ------ Set project ID after creation ------
@projectId = YOUR_PROJECT_ID_HERE

### Create Project
# @name createProject
POST {{host}}/api/v1/projects
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "My First Project",
  "description": "A personal task tracking project",
  "type": "personal"
}

### List All Projects
GET {{host}}/api/v1/projects
Authorization: Bearer {{token}}

### Get Project by ID
GET {{host}}/api/v1/projects/{{projectId}}
Authorization: Bearer {{token}}

### Update Project
PUT {{host}}/api/v1/projects/{{projectId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "My Updated Project",
  "description": "Changed to professional",
  "type": "professional"
}

### Delete Project (soft-delete)
DELETE {{host}}/api/v1/projects/{{projectId}}
Authorization: Bearer {{token}}


### ========================================================================
### 4. BOARDS
### ========================================================================

### ------ Set board ID after creation ------
@boardId = YOUR_BOARD_ID_HERE

### Create Board (with custom swimlanes and task types)
# @name createBoard
POST {{host}}/api/v1/boards
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "project_id": "{{projectId}}",
  "name": "Sprint Board",
  "swimlanes": ["To Do", "In Progress", "In Review", "Done"],
  "task_types": ["Bug", "Feature", "Chore", "Spike"]
}

### Create Board (with defaults — swimlanes & task_types auto-populated)
POST {{host}}/api/v1/boards
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "project_id": "{{projectId}}",
  "name": "Simple Board"
}

### List All Boards
GET {{host}}/api/v1/boards
Authorization: Bearer {{token}}

### List Boards by Project
GET {{host}}/api/v1/boards?project_id={{projectId}}
Authorization: Bearer {{token}}

### Get Board by ID
GET {{host}}/api/v1/boards/{{boardId}}
Authorization: Bearer {{token}}

### Update Board
PUT {{host}}/api/v1/boards/{{boardId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "project_id": "{{projectId}}",
  "name": "Updated Sprint Board",
  "swimlanes": ["Backlog", "To Do", "In Progress", "Done"],
  "task_types": ["Bug", "Feature", "Chore"]
}

### Delete Board (soft-delete)
DELETE {{host}}/api/v1/boards/{{boardId}}
Authorization: Bearer {{token}}


### ========================================================================
### 5. RESOURCES
### ========================================================================

### ------ Set resource ID after creation ------
@resourceId = YOUR_RESOURCE_ID_HERE

### Create Resource (Global scope)
# @name createResource
POST {{host}}/api/v1/resources
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "Jane Developer",
  "type": "Global",
  "linked_items": []
}

### Create Resource (Project scope, linked to a project)
POST {{host}}/api/v1/resources
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "CI/CD Pipeline",
  "type": "Project",
  "linked_items": ["{{projectId}}"]
}

### List All Resources
GET {{host}}/api/v1/resources
Authorization: Bearer {{token}}

### Get Resource by ID
GET {{host}}/api/v1/resources/{{resourceId}}
Authorization: Bearer {{token}}

### Update Resource
PUT {{host}}/api/v1/resources/{{resourceId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "Jane Developer (Senior)",
  "type": "Project",
  "linked_items": ["{{projectId}}"]
}

### Delete Resource (soft-delete)
DELETE {{host}}/api/v1/resources/{{resourceId}}
Authorization: Bearer {{token}}


### ========================================================================
### 6. TASKS
### ========================================================================

### ------ Set task ID after creation ------
@taskId = YOUR_TASK_ID_HERE

### Create Task (with reminders)
# @name createTask
POST {{host}}/api/v1/tasks
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "board_id": "{{boardId}}",
  "swimlane": "To Do",
  "task_type": "Feature",
  "title": "Implement user dashboard",
  "description": "Build the main dashboard with project overview",
  "assignee_id": "{{resourceId}}",
  "estimation_minutes": 240,
  "cost": 100.0,
  "priority": "High",
  "reminders": [
    {"time": "2026-05-15T09:00:00Z", "note": "Start development"},
    {"time": "2026-05-17T09:00:00Z", "note": "Check progress"}
  ]
}

### Create Task (minimal)
POST {{host}}/api/v1/tasks
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "board_id": "{{boardId}}",
  "swimlane": "To Do",
  "task_type": "Bug",
  "title": "Fix login redirect loop",
  "priority": "Critical"
}

### List All Tasks
GET {{host}}/api/v1/tasks
Authorization: Bearer {{token}}

### List Tasks by Board
GET {{host}}/api/v1/tasks?board_id={{boardId}}
Authorization: Bearer {{token}}

### List Tasks by Swimlane
GET {{host}}/api/v1/tasks?swimlane=To%20Do
Authorization: Bearer {{token}}

### List Tasks by Assignee
GET {{host}}/api/v1/tasks?assignee_id={{resourceId}}
Authorization: Bearer {{token}}

### List Tasks by Priority
GET {{host}}/api/v1/tasks?priority=High
Authorization: Bearer {{token}}

### Get Task by ID
GET {{host}}/api/v1/tasks/{{taskId}}
Authorization: Bearer {{token}}

### Patch Task — move to In Progress
PATCH {{host}}/api/v1/tasks/{{taskId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "swimlane": "In Progress"
}

### Patch Task — update priority
PATCH {{host}}/api/v1/tasks/{{taskId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "priority": "Critical",
  "actual_time_minutes": 60
}

### Patch Task — move to Done (triggers recurring task if scheduler linked)
PATCH {{host}}/api/v1/tasks/{{taskId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "swimlane": "Done"
}

### Full Update Task (PUT)
PUT {{host}}/api/v1/tasks/{{taskId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "board_id": "{{boardId}}",
  "swimlane": "In Review",
  "task_type": "Feature",
  "title": "Implement user dashboard (v2)",
  "description": "Revised dashboard with charts",
  "assignee_id": "{{resourceId}}",
  "estimation_minutes": 300,
  "actual_time_minutes": 250,
  "cost": 120.0,
  "priority": "High",
  "reminders": []
}

### Delete Task (soft-delete)
DELETE {{host}}/api/v1/tasks/{{taskId}}
Authorization: Bearer {{token}}


### ========================================================================
### 7. SCHEDULERS
### ========================================================================

### ------ Set scheduler ID after creation ------
@schedulerId = YOUR_SCHEDULER_ID_HERE

### Create Scheduler (daily)
# @name createScheduler
POST {{host}}/api/v1/schedulers
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "Daily Standup",
  "type": "daily"
}

### Create Scheduler (weekly)
POST {{host}}/api/v1/schedulers
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "Weekly Review",
  "type": "weekly"
}

### Create Scheduler (cron — every Monday at 9 AM)
POST {{host}}/api/v1/schedulers
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "Monday Standup",
  "type": "cron",
  "cron_expression": "0 9 * * 1"
}

### List All Schedulers
GET {{host}}/api/v1/schedulers
Authorization: Bearer {{token}}

### Get Scheduler by ID
GET {{host}}/api/v1/schedulers/{{schedulerId}}
Authorization: Bearer {{token}}

### Update Scheduler
PUT {{host}}/api/v1/schedulers/{{schedulerId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "Updated Daily Standup",
  "type": "daily"
}

### Delete Scheduler (soft-delete)
DELETE {{host}}/api/v1/schedulers/{{schedulerId}}
Authorization: Bearer {{token}}


### ========================================================================
### 8. RECURRING TASK WORKFLOW
### ========================================================================
### Steps:
### 1. Create a scheduler (use one from section 7)
### 2. Create a task with scheduler_id set to the scheduler's ID
### 3. PATCH the task's swimlane to "Done"
### 4. A new task is auto-generated in "To Do" swimlane

### Create Task linked to Scheduler
POST {{host}}/api/v1/tasks
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "board_id": "{{boardId}}",
  "swimlane": "To Do",
  "task_type": "Chore",
  "title": "Weekly standup notes",
  "description": "Document standup items each week",
  "priority": "Medium",
  "scheduler_id": "{{schedulerId}}"
}

### Complete the recurring task (move to Done) — auto-generates next one
### Replace RECURRING_TASK_ID with the actual task ID
PATCH {{host}}/api/v1/tasks/RECURRING_TASK_ID
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "swimlane": "Done"
}

### Verify new task was created
GET {{host}}/api/v1/tasks?board_id={{boardId}}&swimlane=To%20Do
Authorization: Bearer {{token}}
