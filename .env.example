# =============================================================================
# .env.example — MyKanban Docker Compose Environment Variables
#
# Copy this file to .env and fill in your secrets:
#   cp .env.example .env
#   vi .env
#
# WARNING: .env contains secrets. It is gitignored. Never commit it.
# =============================================================================

# ─── PostgreSQL ───────────────────────────────────────────────────────────
# REQUIRED: Set a strong password for the database superuser.
PG_PASSWORD=changeme_to_a_strong_random_password

# Optional overrides (defaults are sensible for local dev):
# PG_USER=mycan
# PG_DB=mykanban

# ─── JWT Secret ──────────────────────────────────────────────────────────
# Overrides the "jwt_secret" field in backend/config.json at runtime.
# If unset, the value from config.json is used.
JWT_SECRET=changeme_to_a_strong_random_secret

# ─── CORS Origins ────────────────────────────────────────────────────────
# Comma-separated list of origins the backend will allow.
ALLOWED_ORIGINS=http://localhost:3000

# ─── Google OAuth (Optional) ─────────────────────────────────────────────
# Leave empty if Google sign-in is not configured.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Frontend ────────────────────────────────────────────────────────────
# The API base URL the browser-side Next.js code talks to.
# NOTE: This is embedded at build time — rebuild frontend after changing it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ─── Admin Account ───────────────────────────────────────────────────────
# ROOT_EMAIL=admin@mykanban.local
# ROOT_PASSWORD_HASH=  (bcrypt hash; leave blank to auto-generate at first start)